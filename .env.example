# ─────────────────────────────────────────────────────────────────────────────
# CLIENT env var — baked into the GitHub Pages bundle at `npm run build`.
# Safe to commit (it's a public URL, not a secret). Copy this file to `.env`
# (or `.env.production`) and fill it in.
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of the Vercel deployment that hosts the /api functions.
# Example: https://badland-campers.vercel.app   (NO trailing slash)
REACT_APP_CHECKOUT_API_BASE=

# ─────────────────────────────────────────────────────────────────────────────
# SERVER env vars — DO NOT put these in this repo. Set them in Vercel:
#   Vercel → Project → Settings → Environment Variables (then redeploy).
# Listed here only for documentation.
# ─────────────────────────────────────────────────────────────────────────────

# STRIPE_SECRET_KEY=sk_test_xxx            # required — from Stripe → Developers → API keys
# STRIPE_WEBHOOK_SECRET=whsec_xxx          # required — from the webhook endpoint you create
# STRIPE_ENABLE_TOS_CONSENT=false          # optional — 'true' needs a ToS URL set in Stripe
# ORDER_NOTIFY_WEBHOOK_URL=https://formspree.io/f/xblzbazr   # optional — order-notification target
